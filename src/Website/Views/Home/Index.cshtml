@model IReadOnlyCollection<CrateSample.Application.Dto.OrderListing>

@{
    ViewData["Title"] = "Home Page";

    var colors =
        new Dictionary<string, string>
        {
            { "completed", "blue" },
            { "pending", "orange" },
            { "shipped", "green" }
        };
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div>
    @foreach (var customerOrder in @Model)
    {
        <ul>
            <h2>Customer: @customerOrder.Customer?.CustomerFirstName @customerOrder.Customer?.CustomerLastName</h2>
            @foreach (var order in customerOrder.Orders!)
            {
                <li>
                    <div>Order Number: <strong>@order.OrderNumber</strong></div>
                    <div>Order Date: <strong>@order.OrderDate.ToShortDateString()</strong></div>
                    <div>Order Total: $<strong>@order.OrderTotal</strong></div>
                    <div>Order Status: <strong style="text-transform: capitalize; color: @colors[@order.OrderStatus!]">@order.OrderStatus</strong></div>
                    <p>&nbsp;</p>
                </li>
            }
        </ul>
    }
</div>