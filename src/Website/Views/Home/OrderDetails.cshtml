@model IReadOnlyCollection<CrateSample.Application.Dto.OrderDetail>

@{
    ViewData["Title"] = "Order Details";
    string FmtDate(DateTime d) => d.ToString("yyyy-MM-dd");
    string FmtMoney(decimal d) => d.ToString("C");
}

<h1>Order Details</h1>

@if (Model is null || Model.Count == 0)
{
    <div class="alert alert-warning">No details found for this order.</div>
}
else
{
    @foreach (var detail in Model)
    {
        var c = detail.Customer;
        var info = detail.Info;

        <div class="card mb-4">
            <div class="card-header">
                <strong>Order</strong> @info?.OrderNumber
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9">
                        @($"{c?.CustomerFirstName} {c?.CustomerLastName}".Trim())
                    </dd>

                    <dt class="col-sm-3">Order Date</dt>
                    <dd class="col-sm-9">@((info is null) ? "—" : FmtDate(info.OrderDate))</dd>

                    <dt class="col-sm-3">Total</dt>
                    <dd class="col-sm-9">@((info is null) ? "—" : FmtMoney(info.OrderTotal))</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@info?.OrderStatus</dd>
                </dl>
            </div>
        </div>

        if (detail.Items is { Count: > 0 })
        {
            <h3>Line Items</h3>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Item ID</th>
                            <th>Name</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in detail.Items)
                        {
                            var lineTotal = it.ItemQuantity * it.ItemPrice;
                            <tr>
                                <td class="text-monospace">@it.ItemId</td>
                                <td>@it.ItemName</td>
                                <td class="text-end">@it.ItemQuantity</td>
                                <td class="text-end">@FmtMoney(it.ItemPrice)</td>
                                <td class="text-end">@FmtMoney(lineTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-secondary">No line items available.</div>
        }
    }

    <p class="mt-3">
        <a class="btn btn-secondary" href="@Url.Action("Index","Home")">Back to search</a>
    </p>
}
